
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets and local configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Local datasets and generated data
data/raw/
data/processed/
data/evidence/
!data/evidence/.gitkeep

# Derived manifests contain dataset captions - never commit.
# The directory itself stays excluded, so the layout note is re-included by
# name rather than by pattern; git cannot descend into an excluded directory.
data/manifests/*
!data/manifests/README.md

# Generated sample images and feature files - never commit
data/sample/

# Trained models and checkpoints
models/*
!models/README.md
*.pt
*.pth
*.ckpt
*.safetensors
*.pkl

# Vector database and index files
vector_store/
chroma_db/
faiss_index/

# Notebook and experiment output
.ipynb_checkpoints/
mlruns/
outputs/
logs/

# Generated conformance and audit reports - regenerated by the test suite
reports/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local dataset copies - third-party news photography, never commit
dataset/
ooc_dataset.zip
